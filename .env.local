# Local Development Environment Variables
# Copy this to .env and fill in your values

# AWS Credentials (for Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Database (auto-configured by docker-compose)
DATABASE_URL=postgresql://foresight:dev_password_123@localhost:5432/foresight
REDIS_URL=redis://localhost:6379/0

# Bedrock Configuration
COST_TRACKING_ENABLED=true
MONTHLY_BUDGET_USD=50
ENABLE_MODEL_FALLBACK=true

# Use cheaper models for development
SIGNAL_SYNTHESIZER_MODEL=us.anthropic.claude-haiku-3-5-v1:0
DRIVER_EXTRACTOR_MODEL=us.anthropic.claude-haiku-3-5-v1:0
SCENARIO_CONSTRUCTOR_MODEL=us.anthropic.claude-sonnet-4-5-v1:0
NARRATIVE_GENERATOR_MODEL=us.anthropic.claude-haiku-3-5-v1:0
SIGNPOST_DESIGNER_MODEL=us.anthropic.claude-haiku-3-5-v1:0
ACTION_PLANNER_MODEL=us.anthropic.claude-haiku-3-5-v1:0
QUALITY_CRITIC_MODEL=us.anthropic.claude-haiku-3-5-v1:0

# Development settings
LOG_LEVEL=DEBUG
CACHE_ENABLED=true
PII_DETECTION_ENABLED=false
OUTPUT_VALIDATION_STRICT=false
