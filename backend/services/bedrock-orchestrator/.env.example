# AWS Configuration
AWS_REGION=us-east-1
# Optional - if not using IAM role
# AWS_ACCESS_KEY_ID=your_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_here

# Model Configuration - Override defaults if needed
# SIGNAL_SYNTHESIZER_MODEL=us.anthropic.claude-sonnet-4-5-v1:0
# DRIVER_EXTRACTOR_MODEL=us.anthropic.claude-sonnet-4-5-v1:0
# SCENARIO_CONSTRUCTOR_MODEL=us.anthropic.claude-sonnet-4-5-v1:0
# NARRATIVE_GENERATOR_MODEL=us.anthropic.claude-sonnet-4-5-v1:0
# SIGNPOST_DESIGNER_MODEL=us.anthropic.claude-haiku-3-5-v1:0
# ACTION_PLANNER_MODEL=us.anthropic.claude-sonnet-4-5-v1:0
# QUALITY_CRITIC_MODEL=us.anthropic.claude-haiku-3-5-v1:0

# Performance Settings
MAX_TOKENS=4096
TEMPERATURE_DEFAULT=1.0
TEMPERATURE_CREATIVE=1.0
TEMPERATURE_ANALYTICAL=0.7

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_TOKENS_PER_MINUTE=200000

# Caching
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/1
CACHE_TTL_SECONDS=3600

# Safety and Guardrails
PII_DETECTION_ENABLED=true
CONTENT_FILTERING_ENABLED=true
MAX_CONTEXT_LENGTH=200000
OUTPUT_VALIDATION_STRICT=true

# Retry & Fallback
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=2
ENABLE_MODEL_FALLBACK=true

# Cost Optimization
COST_TRACKING_ENABLED=true
MONTHLY_BUDGET_USD=10000
COST_ALERT_THRESHOLD=0.8

# Observability
LOG_LEVEL=INFO
TRACE_ENABLED=true
LOG_PROMPTS=true
LOG_OUTPUTS=true
METRICS_ENABLED=true

# Multi-tenancy
TENANT_ISOLATION_ENABLED=true
DEFAULT_TENANT_QUOTA_REQUESTS_PER_DAY=2000
